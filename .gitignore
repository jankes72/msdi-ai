# SSI/MSDI AI - .gitignore
# System ignorowania plików dla repozytorium Git

# ============================================================================
# PYTHON
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# translators
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/
venv.bak/
env.bak/

# IDE
# ============================================================================

# PyCharm
.idea/

# VSCode
.vscode/
*.code-workspace

# Sublime Text
*.sublime-workspace
*.sublime-project

# JetBrains
*.iml

# Editor
*.swp
*.swo
*~
.project
.settings/
.pydevproject
.validation/

# macOS
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Temp
.Trash
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
# ============================================================================
*~
.nfs*

# Windows
# ============================================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# DATA FILES - Ignore all data files
# ============================================================================

# CSV files
*.csv

# JSON data files - ignore large data files
# EXCEPT: SSI memory files and runtime state (critical for system operation)
*.json
!SSI/memory/**/*.json
!SSI/v5/runtime/*.json
!SSI/v5/runtime/*.log

# Database files
*.db
*.sqlite
*.sqlite3

# ML model files (large binaries)
*.joblib
*.pkl
*.h5
*.hdf5
*.keras
*.tflite
*.onnx
*.pt
*.pth
*.npz
*.npy

# ============================================================================
# PROJECT SPECIFIC - SSI/MSDI AI
# ============================================================================

# Large prediction database file (do not analyze)
generatorDataBaseTrendAnalisAll.py

# Prepared data files (ignore CSV files but keep directories)
kursy_przygotowane.csv
wyniki/

# Model files (binary, large)
dataBase_futbol_trendijerison01.joblib
dataBase_futbol_trend.joblib
dataBase_futbol_trend joblib/

# ============================================================================
# SSI DIRECTORIES - Code only, no data
# ============================================================================

# Data directories (contents ignored, but keep .gitkeep files)
SSI/data/raw/*
!SSI/data/raw/.gitkeep
SSI/data/processed/*
!SSI/data/processed/.gitkeep
SSI/data/worlds/*
!SSI/data/worlds/.gitkeep
SSI/data/results/*
!SSI/data/results/.gitkeep

# V3 Memory (large files - ignore contents but keep .gitkeep)
SSI/v3/memory/*
!SSI/v3/memory/.gitkeep
SSI/v3/metadata/*
!SSI/v3/metadata/.gitkeep
SSI/v3/relationships/*
!SSI/v3/relationships/.gitkeep

# V2 Models output
SSI/v2/models/*
!SSI/v2/models/.gitkeep
SSI/v2/training/*
!SSI/v2/training/.gitkeep
SSI/v2/observation/*
!SSI/v2/observation/.gitkeep

# V4 Agents
SSI/v4/agents/*
!SSI/v4/agents/.gitkeep
SSI/v4/population/*
!SSI/v4/population/.gitkeep

# Laboratories
SSI/laboratories/*/*
!SSI/laboratories/*/.gitkeep

# Feedback and evolution
SSI/feedback/*
!SSI/feedback/.gitkeep
SSI/evolution/*
!SSI/evolution/.gitkeep

# Strategy
SSI/strategy/*
!SSI/strategy/.gitkeep

# ============================================================================
# OTHER RESULT DIRECTORIES
# ============================================================================

archiwa/
archiwum_*/
backup_*/

laboratorium/

modele_dataBase_futbol_trend/
modele_kursy_przygotowane/

# ============================================================================
# KATALOGI, KTÓRE MUSZĄ BYĆ W GIT (Zgodnie z PROJECT_RULES.md)
# ============================================================================

# pamiec_modeli_v2 - KOD ŹRÓDŁOWY
# Zgodnie z PROJECT_RULES.md linia 232: !SSI/**/*.py
# i linia 232: „Kod źródłowy” - *.py TAK (Git)
# CRITICAL: NIE MOŻE BYĆ WYKLUCZONY!
!pamiec_modeli_v2/
!pamiec_modeli_v2/**/*.py
!pamiec_modeli_v2/**/__init__.py

# Fixture testowe - wersjonowane dane testowe
# Zgodnie z Sprint 7.1: Fixture danych przeznaczony wyłącznie do testów
!data/fixtures/
!data/fixtures/**/*.py
!data/fixtures/**/*.csv
!data/fixtures/**/*.json
!data/fixtures/**/*.yaml
!data/fixtures/**/__init__.py

# Wersjonowane pliki struktury wymagań (Sprint 9)
# Zgodnie z dokumentacją: stuktura1.csv - stuktura4.csv są źródłem prawdy
!SSI_DOCUMENTATION/stuktura1.csv
!SSI_DOCUMENTATION/stuktura2.csv
!SSI_DOCUMENTATION/stuktura3.csv
!SSI_DOCUMENTATION/stuktura4.csv

# ============================================================================
# EXCEPTIONS - Files that SHOULD be in Git
# ============================================================================

# Keep all Python files in SSI
!SSI/*.py
!SSI/**/*.py
!SSI/README.md

# Keep gitkeep files for empty directories
!SSI/*.gitkeep
!SSI/**/*.gitkeep

# Keep directory structure
!SSI/core/
!SSI/config/
!SSI/data/
!SSI/utils/
!SSI/v2/
!SSI/v3/
!SSI/v4/
!SSI/strategy/
!SSI/laboratories/
!SSI/feedback/
!SSI/decision/
!SSI/evolution/
!SSI/tests/

# Keep documentation
!SSI_DOCUMENTATION/
!SSI_DOCUMENTATION/**

# ============================================================================
# LOGS AND CACHE
# ============================================================================

# Logs
*.log
logs/

# Cache
__pycache__/
*.pyc

# Jupyter
.notebooks/
*.ipynb
.ipynb_checkpoints/
